# MongoDB connection URI as set in police-cad .env
dbo=knoldus
mongoURI=mongodb://localhost/knoldus

# Discord Bot Token
token=

# Lines Police CAD API
API_URL=https://backend.yourdomain.com

# Server-to-server secret shared with the API. Must match the API's
# API_GATEWAY_KEY exactly. It is how the bot tells the API which LPC user is
# acting, since API_TOKEN is shared and identifies only the bot. Required by
# /invite and /join; leave blank and those commands report they are not
# configured.
API_GATEWAY_KEY=

# Health heartbeat secret. Must match BOT_HEARTBEAT_TOKEN on the API.
# Placeholder only, replace with the real value in your local .env.
BOT_HEARTBEAT_TOKEN=replace-with-shared-heartbeat-secret
